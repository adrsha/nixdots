{
    "layer": "top",
    "position": "top",
    "reload_style_on_change": true,
    "modules-left": ["hyprland/workspaces", "privacy", "group/tray", "custom/playerctl"],
    "modules-center": ["clock"],
    "modules-right": ["group/perf", "group/configs", "privacy", "custom/control-center"],

    "custom/playerctl": {
        "format": "{}",
        "tooltip": false,
        "interval": 1,
        "exec": "~/.config/waybar/scripts/playerctl_status.sh",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    },

    "hyprland/workspaces": {
        "all-outputs": false,
        "format": "{name} <span font_size='9pt'>{windows}</span>",
        "show-special": true,
        "special-visible-only": true,
        "window-rewrite-default": "",
        "window-rewrite": {
            "class<firefox>": "󰈹",
            "class<firefox> title<.*github.*>": "",
            "class<firefox> title<.*youtube.*>": "󰗃",
            "class<firefox> title<.*discord.*>": "󰙯",
            "class<firefox> title<.*gitlab.*>": "",
            "class<firefox> title<.*claude.*>": "󰚩",
            "class<firefox> title<.*chatgpt.*>": "󰚩",
            "class<firefox> title<Picture-in-Picture>": "",
            "sterminal": "",
            "kitty": "󰄛",
            "wezterm": "",
            "class<wezterm> title<.*>": "<span font_size='10pt'>󰦱</span>",
            "class<UnrealEditor> title<.+>": "<span font_size='10pt'>󰦱</span>",
            "class<UnrealEditor> title<>": "󰦱",
            "class<io.github.achetagames.epic_asset_manager>": "",
            "code": "󰨞",
            "title<btop>": "󰊚",
            "KeePassXC": "",
            "Rofi": "󰮫",
            "music": "",
            "thunar": "",
            "steam": "",
            "discord": "󰙯",
        }
    },

    "group/perf": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": false,
            "children-class": "perf-element"
        },
        "modules": ["custom/perf-icon", "temperature", "cpu", "memory"]
    },

    "custom/perf-icon": {
        "tooltip": false,
        "format": "󰍜"
    },

    "group/configs": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": false,
            "children-class": "misc-element",
            "click-to-reveal": true
        },
        "modules": ["custom/config-icon", "bluetooth", "pulseaudio#input", "pulseaudio#output", "network"]
    },

    "custom/config-icon": {
        "tooltip": false,
        "format": ""
    },

    "custom/control-center": {
        "tooltip": false,
        "format": "",
        "on-click": "walker",
        "escape": true
    },

    "clock": {
        "format": "{:L%A, %B %d, %Y  •  %I:%M %p}",
        "format-alt": "{:L%I:%M:%S %p}",
        "interval": 1,
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "smooth-scrolling-threshold": 0.01,
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#dadada'><b>{}</b></span>",
                "days": "<span color='#dadada'>{}</span>",
                "weeks": "<span color='#8CCF7E'><b>W{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#CE6969'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click": "mode",
            "on-click-right": "shift_reset",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰛳",
        "format-disconnected": "󰌙",
        "tooltip-format-disconnected": "Not connected",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname} 🖧   {bandwidthUpBits}  {bandwidthDownBits}",
        "on-click": "wezterm start --class 'floating' -e nmtui"
    },

    "bluetooth": {
        "format-on": "󰂯",
        "format-off": "BT-off",
        "format-disabled": "󰂲",
        "format-no-controller": "",
        "format-connected-battery": "{device_battery_percentage}% 󰂯",
        "format-alt": "{device_alias} 󰂯",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\n{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\n{device_address}\n{device_battery_percentage}%",
        "on-click-right": "blueberry"
    },

    "group/tray": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": true,
            "children-class": "tray-element"
        },
        "modules": ["custom/tray-icon", "tray"]
    },

    "custom/tray-icon": {
        "format": " ",
        "tooltip": true,
        "tooltip-format": "System Tray"
    },

    "cpu": {
        "format": "󰻠 {usage}% ",
        "tooltip": true
    },

    "memory": {
        "format": "󰍛 {percentage}% ",
        "tooltip": true
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "󰔏 {temperatureC}° ",
        "hwmon-path": "/sys/devices/pci0000:00/0000:00:18.3/hwmon/hwmon1/temp1_input",
        "tooltip-format": "CPU: {temperatureC}°C"
    },

    "tray": {
        "icon-size": 14,
        "spacing": 10
    },

    "custom/endpoint": {
        "format": " ",
        "tooltip": false
    },

    "privacy": {
        "icon-spacing": 10,
        "icon-size": 12,
        "transition-duration": 250,
        "format": "󰁵",
        "modules": [
            {
                "type": "screenshare",
                "tooltip": true,
                "tooltip-icon-size": 24
            },
            {
                "type": "audio-in",
                "tooltip": true,
                "tooltip-icon-size": 24
            }
        ],
        "ignore-monitor": true,
        "ignore": [
            {
                "type": "audio-in",
                "name": "cava"
            },
            {
                "type": "screenshare",
                "name": "obs"
            }
        ]
    },

    "pulseaudio#input": {
        "scroll-step": 1,
        "format": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": " ",
        "tooltip-format": "{format_source}",
        "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +5%",
        "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -5%"
    },

    "pulseaudio#output": {
        "scroll-step": 1,
        "format": "{volume}% {icon}",
        "format-bluetooth": "󰂰",
        "format-bluetooth-muted": "{format_muted}",
        "format-muted": "",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "phone": "",
            "default": ["", "", "", ""]
        },
        "tooltip-format": "{desc}",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol"
    }
}
